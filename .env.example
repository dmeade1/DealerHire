# Never put real secrets here. Copy to .env for local development.
# Admin (superuser): migrate + fixture seed. App role: runtime / RLS proofs.
DATABASE_URL_ADMIN=postgres://dealerhire:dealerhire@localhost:5432/dealerhire
DATABASE_URL=postgres://dealerhire_app:dealerhire_app@localhost:5432/dealerhire
HYPERDRIVE_URL=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
# Auth mode ceiling: hmac-g1 (local default) | idp (production default).
# Production HMAC requires ALLOW_HMAC_ACTOR_IN_PRODUCTION=true (G1 preview only).
DH_AUTH_MODE=hmac-g1
ALLOW_HMAC_ACTOR_IN_PRODUCTION=false
# local = insecure base64 stand-in only. Do not use for live PII (G2 requires KMS encryption).
ACCEPTANCE_ENVELOPE_BINDING=local
# Required for capability hashing — never use a shared default in any environment.
CAPABILITY_SECRET=replace-with-local-dev-secret
# Required to arm/read kill switches over HTTP (fail closed if unset).
OPS_CONTROL_SECRET=replace-with-local-ops-control-secret
AI_GATEWAY_BASE_URL=
AI_PROVIDER_ROUTE=disabled
EMAIL_PROVIDER=disabled
PUBLIC_BASE_URL=http://localhost:3000
SYNTHETIC_TENANT_ID=00000000-0000-4000-8000-000000000001
SYNTHETIC_ROOFTOP_ID=00000000-0000-4000-8000-000000000002
SYNTHETIC_JOB_CONTROL_VERSION_ID=00000000-0000-4000-8000-00000000000a
# Local G1 only: allow dealer/ops layouts without signed x-dh-actor headers.
# Ignored when NODE_ENV=production. Never enable outside local skeleton work.
ALLOW_UNSIGNED_SYNTHETIC_ACTOR=true
