{
  "name": "dealerhire",
  "version": "0.1.0",
  "private": true,
  "description": "DealerHire — automotive labor intelligence platform (modular monolith)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d postgres || docker-compose up -d postgres || docker start dealerhire-pg || docker run -d --name dealerhire-pg -e POSTGRES_USER=dealerhire -e POSTGRES_PASSWORD=dealerhire -e POSTGRES_DB=dealerhire -p 5432:5432 postgres:16-alpine",
    "db:down": "docker compose down || docker-compose down || docker rm -f dealerhire-pg",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:migrate:check": "node --import tsx scripts/migrate.ts --check",
    "db:seed": "node --import tsx scripts/seed.ts",
    "worker:intake": "wrangler dev -c wrangler.intake.toml",
    "worker:backplane": "wrangler dev -c wrangler.backplane.toml",
    "ops": "node --import tsx scripts/ops-cli.ts",
    "scan:pii": "node --import tsx scripts/scan-synthetic-pii.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm db:migrate:check && pnpm scan:pii && pnpm build"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.3.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.20250317.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.8"
    }
  }
}
